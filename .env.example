# Hermes AI Agent Configuration
# Base URL of your local or remote Hermes server (OpenAI-compatible endpoints)
HERMES_BASE_URL=http://127.0.0.1:8642/v1

# API Key for Hermes authentication (if configured on server)
HERMES_API_KEY=your-hermes-api-key-here

# Hermes Model identifier
HERMES_MODEL=hermes-agent

# Timeout in milliseconds (default: 120000 = 2 minutes)
HERMES_REQUEST_TIMEOUT_MS=120000
